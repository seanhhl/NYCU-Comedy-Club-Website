---
import Navbar from '../components/Navbar.astro';
const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="交大貢丸喜劇社 NYCU Comedy Club" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="ambient-bg">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
    <Navbar />
    <div class="page-content fade-in">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #09090b;       /* True Black */
    --surface-card: #13141f;  /* Deep Dark Blue */
    --surface-hover: #1e293b; /* Slightly lighter blue for interaction */
    
    --text-main: #f8fafc;     /* Soft White */
    --text-muted: #94a3b8;    /* Muted Slate */
    
    --accent-blue: #bae6fd;   /* Lighter Soft Blue */
    --accent-orange: #fed7aa; /* Lighter Soft Orange */
    
    --glow-blue: rgba(125, 211, 252, 0.15);
    --glow-orange: rgba(253, 186, 116, 0.15);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: var(--bg-main);
    color: var(--text-main);
    overflow-x: hidden;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    position: relative;
    z-index: 10;
  }

  /* Page Load Animation */
  .fade-in {
    animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    opacity: 0;
    transform: translateY(15px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Ambient Geometric Background */
  .ambient-bg {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    opacity: 0.15; /* Soft and subtle */
    animation: float 20s infinite alternate ease-in-out;
  }

  .shape-1 {
    width: 45vmax; height: 45vmax;
    background: var(--accent-blue);
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    top: -15%; left: -10%;
    animation-delay: 0s;
  }
  
  .shape-2 {
    width: 40vmax; height: 40vmax;
    background: var(--accent-orange);
    border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%;
    bottom: -15%; right: -10%;
    animation-duration: 25s;
    animation-delay: -5s;
  }

  .shape-3 {
    width: 30vmax; height: 30vmax;
    background: var(--surface-hover);
    border-radius: 30% 70% 50% 50% / 50% 30% 70% 50%;
    top: 30%; left: 60%;
    animation-duration: 30s;
    animation-delay: -15s;
  }

  @keyframes float {
    0% { transform: translate(0, 0) rotate(0deg) scale(1); }
    50% { transform: translate(8%, 12%) rotate(15deg) scale(1.05); }
    100% { transform: translate(-8%, -5%) rotate(-10deg) scale(0.95); }
  }

  /* Typography basics */
  h1, h2, h3, h4, h5, h6 {
    color: var(--accent-blue);
    margin-top: 0;
  }
  
  /* Make main h1 stand out */
  h1 {
    color: var(--text-main);
  }
  a {
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a:hover {
    color: var(--accent-orange);
  }
</style>
