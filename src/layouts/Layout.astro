---
import Navbar from '../components/Navbar.astro';
const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Background Animated Orbs -->
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>
    <div class="bg-shape shape-3"></div>

    <Navbar />
    
    <main class="page-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #0F172A; /* Slate 900 */
    --text-color: #F8FAFC; /* Slate 50 */
    --accent-blue: #38BDF8; /* Sky 400 */
    --accent-orange: #FB923C; /* Orange 400 */
    --navbar-bg: rgba(15, 23, 42, 0.75);
  }
  
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Helvetica Neue', Arial, 'Microsoft JhengHei', sans-serif;
    margin: 0;
    background-color: var(--bg-color);
    color: var(--text-color);
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
  }

  /* Typography */
  h1, h2, h3 {
    color: var(--accent-blue);
  }

  a {
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  
  a:hover {
    color: var(--accent-orange);
  }

  /* Page Load Animation */
  .page-content {
    padding: 2rem;
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
    animation: fadeUp 0.8s ease-out forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Floating Geometric Background Orbs */
  .bg-shape {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15; /* Subtle */
    z-index: 0;
    pointer-events: none;
    animation: float 20s infinite ease-in-out alternate;
  }

  .shape-1 {
    width: 40vw;
    height: 40vw;
    background: var(--accent-blue);
    top: -10%;
    left: -10%;
    animation-delay: 0s;
  }

  .shape-2 {
    width: 35vw;
    height: 35vw;
    background: var(--accent-orange);
    bottom: -10%;
    right: -10%;
    animation-delay: -5s;
  }

  .shape-3 {
    width: 25vw;
    height: 25vw;
    background: #6366F1; /* Indigo to blend */
    top: 40%;
    left: 20%;
    animation-delay: -10s;
  }

  @keyframes float {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(5vw, 10vh) scale(1.1);
    }
  }
</style>
