---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const title = '活動歷程';

const allTimeline = await getCollection('timeline');
allTimeline.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title={title}>
  <header class="page-header">
    <h1>{title}</h1>
    <p class="subtitle">追蹤我們的足跡，見證每一個笑聲的誕生。</p>
  </header>
  
  <section class="timeline-section">
    {allTimeline.length === 0 ? (
      <p class="empty-state">目前沒有活動紀錄</p>
    ) : (
      <div class="timeline">
        {allTimeline.map((event, index) => (
          <div class="timeline-item" style={`animation-delay: ${index * 0.1}s`}>
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <div class="timeline-date">{event.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
              <h3 class="timeline-title">{event.data.title}</h3>
              <p class="timeline-desc">{event.data.description}</p>
              
              {event.data.photos && event.data.photos.length > 0 && (
                <div class="photo-gallery">
                  {event.data.photos.map(photo => {
                    let imgSrc = photo;
                    if (!photo.startsWith('http') && !photo.startsWith('data:')) {
                       const base = import.meta.env.BASE_URL;
                       const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
                       const cleanPhoto = photo.startsWith('/') ? photo.slice(1) : photo;
                       imgSrc = `${cleanBase}/${cleanPhoto}`;
                    }
                    return <img src={imgSrc} alt={event.data.title} loading="lazy" />
                  })}
                </div>
              )}
              
              {event.data.speaker && (
                <div class="speaker-card">
                  {event.data.speaker.photo && (
                    <div class="avatar-ring">
                      <img class="avatar" src={event.data.speaker.photo} alt={event.data.speaker.name} loading="lazy" />
                    </div>
                  )}
                  <div class="speaker-info">
                    <h4>{event.data.speaker.name}</h4>
                    {event.data.speaker.role && <p class="role">{event.data.speaker.role}</p>}
                    {event.data.speaker.bio && <p class="bio">{event.data.speaker.bio}</p>}
                  </div>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .page-header {
    margin-bottom: 4rem;
  }
  
  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }

  /* Vertical Timeline */
  .timeline {
    position: relative;
    padding-left: 2.5rem;
  }

  /* The vertical line */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent-blue), transparent);
    opacity: 0.5;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    /* Item reveal animation */
    opacity: 0;
    animation: slideInRight 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: none; }
  }

  /* The glowing dot */
  .timeline-dot {
    position: absolute;
    left: calc(-2.5rem - 5px); /* perfectly centered on the line (2.5rem padding + 6px half width) */
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--accent-blue);
    box-shadow: 0 0 15px 2px var(--glow-blue);
    /* Removed the black border to let it glow */
  }

  /* Surface Card */
  .timeline-content {
    position: relative;
    z-index: 0;
    background: transparent;
    border-radius: 12px;
    padding: 1.5rem 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  
  .timeline-content::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--surface-card);
    z-index: -1;
  }
  
  .timeline-content::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(45deg, var(--accent-blue), var(--accent-orange));
    z-index: -2;
    filter: blur(15px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .timeline-content:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  }
  
  .timeline-content:hover::after {
    opacity: 0.5;
  }

  .timeline-date {
    color: var(--accent-orange);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
  }

  .timeline-title {
    color: var(--text-main);
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  .timeline-desc {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Gallery */
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .photo-gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9; /* keep grid uniform but contain image */
    object-fit: contain;
    border-radius: 8px;
    transition: transform 0.3s ease;
    background: rgba(0,0,0,0.2); /* add dark background for non-filling images */
  }

  .photo-gallery img:hover {
    transform: scale(1.05);
  }

  /* Speaker Card */
  .speaker-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .speaker-card .avatar-ring {
    display: inline-block;
    background: var(--accent-blue);
    border-radius: 70% 50%;
    padding: 1px;
    box-shadow: 0 0 10px rgba(125, 212, 252, 0.3);
    flex-shrink: 0;
  }

  .speaker-card .avatar {
    display: block;
    width: 60px;
    height: 60px;
    border-radius: 50% 70%;
    object-fit: cover;
    border: 0px solid var(--bg-main);
  }

  .speaker-info h4 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.1rem;
  }

  .speaker-info .role {
    color: var(--accent-orange);
    font-weight: 500;
    font-size: 0.85rem;
    margin: 0.2rem 0 0.5rem 0;
  }

  .speaker-info .bio {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 1.5rem;
    }
    .timeline-dot {
      left: calc(-1.5rem - 5px);
    }
    .timeline-content {
      padding: 1.2rem;
    }
  }
</style>
