---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const title = '活動歷程';

const allTimeline = await getCollection('timeline');
allTimeline.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title={title}>
  <header class="page-header">
    <h1>{title}</h1>
    <p class="subtitle">追蹤我們的足跡，見證每一個笑聲的誕生。</p>
  </header>
  
  <section class="timeline-section">
    {allTimeline.length === 0 ? (
      <p class="empty-state">目前沒有活動紀錄</p>
    ) : (
      <div class="timeline">
        {allTimeline.map((event, index) => (
          <div class="timeline-item" style={`animation-delay: ${index * 0.1}s`}>
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <div class="timeline-date">{event.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
              <h3 class="timeline-title">{event.data.title}</h3>
              <p class="timeline-desc">{event.data.description}</p>
              
              {event.data.photos && event.data.photos.length > 0 && (
                <div class="photo-gallery">
                  {event.data.photos.map(photo => {
                    // Ensure proper path resolution for images
                    let imgSrc = photo;
                    if (!photo.startsWith('http') && !photo.startsWith('data:')) {
                       const base = import.meta.env.BASE_URL;
                       const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
                       const cleanPhoto = photo.startsWith('/') ? photo.slice(1) : photo;
                       imgSrc = `${cleanBase}/${cleanPhoto}`;
                    }
                    return <img src={imgSrc} alt={event.data.title} loading="lazy" />
                  })}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .page-header {
    margin-bottom: 4rem;
  }
  
  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }

  /* Vertical Timeline */
  .timeline {
    position: relative;
    padding-left: 2.5rem;
  }

  /* The vertical line */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent-blue), transparent);
    opacity: 0.5;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    /* Item reveal animation */
    opacity: 0;
    animation: slideInRight 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* The glowing dot */
  .timeline-dot {
    position: absolute;
    left: calc(-2.5rem - 5px); /* perfectly centered on the line (2.5rem padding + 6px half width) */
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--accent-blue);
    box-shadow: 0 0 15px 2px var(--glow-blue);
    /* Removed the black border to let it glow */
  }

  /* Surface Card */
  .timeline-content {
    background: linear-gradient(145deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 60%), var(--surface-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .timeline-content:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.5), 0 0 15px rgba(125, 211, 252, 0.4);
    border-color: rgba(125, 211, 252, 0.3);
  }

  .timeline-date {
    color: var(--accent-orange);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
  }

  .timeline-title {
    color: var(--text-main);
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  .timeline-desc {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Gallery */
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .photo-gallery img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 8px;
    transition: transform 0.3s ease;
  }

  .photo-gallery img:hover {
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 1.5rem;
    }
    .timeline-dot {
      left: calc(-1.5rem - 6px);
    }
    .timeline-content {
      padding: 1.2rem;
    }
  }
</style>
