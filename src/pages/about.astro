---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const title = '關於我們';

const allFaq = await getCollection('faq') || [];
allFaq.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const allTeam = await getCollection('team') || [];
allTeam.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const renderedTeam = await Promise.all(allTeam.map(async (member) => {
  const { Content } = await render(member);
  return { ...member, Content };
}));
---
<Layout title={title}>
  <h1>{title}</h1>
  
  <section style="margin-top: 3rem;">
    <h2>常見問題 (FAQ)</h2>
    {allFaq.length === 0 ? (
      <p><em>(目前沒有常見問題)</em></p>
    ) : (
      <div class="faq-grid">
        {allFaq.map((faq, index) => (
          <div class="faq-card" style={`animation-delay: ${index * 0.1}s`}>
            <dt class="faq-question">Q: {faq.data.question}</dt>
            <dd class="faq-answer">A: {faq.data.answer}</dd>
          </div>
        ))}
      </div>
    )}
  </section>

  <section style="margin-top: 4rem;">
    <h2>幹部介紹</h2>
    {renderedTeam.length === 0 ? (
      <p><em>(目前沒有幹部介紹)</em></p>
    ) : (
      <div class="team-grid">
        {renderedTeam.map((member, index) => (
          <div class="team-card" style={`animation-delay: ${index * 0.1}s`}>
            {member.data.photo && (
              <img 
                src={member.data.photo.startsWith(import.meta.env.BASE_URL) ? member.data.photo : `${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL}/${member.data.photo.startsWith('/') ? member.data.photo.slice(1) : member.data.photo}`} 
                alt={member.data.title} 
                class="team-photo"
              />
            )}
            <h3>{member.data.title}</h3>
            <p class="team-role">{member.data.role}</p>
            <div class="team-content">
              <member.Content />
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  /* FAQ Styling */
  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .faq-card {
    background: rgba(30, 41, 59, 0.4);
    border-left: 4px solid var(--accent-orange);
    padding: 1.5rem;
    border-radius: 0 8px 8px 0;
    backdrop-filter: blur(5px);
    opacity: 0;
    animation: fadeUp 0.5s ease-out forwards;
  }
  .faq-question {
    font-weight: bold;
    font-size: 1.1rem;
    color: var(--text-color);
    margin-bottom: 0.5rem;
  }
  .faq-answer {
    margin-left: 0;
    color: #CBD5E1;
    line-height: 1.6;
  }

  /* Team Styling */
  .team-grid {
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); 
    gap: 2rem; 
    margin-top: 2rem;
  }
  .team-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 2rem 1.5rem;
    border-radius: 12px;
    text-align: center;
    backdrop-filter: blur(10px);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    animation: fadeUp 0.6s ease-out forwards;
  }
  .team-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    border-color: rgba(56, 189, 248, 0.3);
  }
  .team-photo {
    width: 120px; 
    height: 120px; 
    border-radius: 50%; 
    object-fit: cover; 
    margin-bottom: 1rem;
    border: 3px solid var(--accent-blue);
    padding: 3px;
  }
  .team-card h3 {
    margin: 0;
    color: var(--text-color);
    font-size: 1.3rem;
  }
  .team-role {
    color: var(--accent-blue);
    font-weight: 600;
    margin: 0.5rem 0 1rem 0;
    font-size: 0.9rem;
  }
  .team-content {
    font-size: 0.9em; 
    text-align: left;
    color: #CBD5E1;
    line-height: 1.5;
  }
</style>

