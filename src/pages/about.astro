---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const title = '關於我們';

const allFaq = await getCollection('faq') || [];
allFaq.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const allTeam = await getCollection('team') || [];
allTeam.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const renderedTeam = await Promise.all(allTeam.map(async (member) => {
  const { Content } = await render(member);
  return { ...member, Content };
}));
---
<Layout title={title}>
  <header class="page-header">
    <h1>{title}</h1>
    <p class="subtitle">認識我們，了解我們在做什麼。</p>
  </header>
  
  <section class="content-section">
    <h2>常見問題 (FAQ)</h2>
    {allFaq.length === 0 ? (
      <p class="empty-state">目前沒有常見問題</p>
    ) : (
      <div class="faq-list">
        {allFaq.map((faq, index) => (
          <div class="faq-card" style={`animation-delay: ${index * 0.05}s`}>
            <h3 class="question">Q: {faq.data.question}</h3>
            <p class="answer">A: {faq.data.answer}</p>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="content-section">
    <h2>幹部介紹</h2>
    {renderedTeam.length === 0 ? (
      <p class="empty-state">目前沒有幹部介紹</p>
    ) : (
      <div class="team-grid">
        {renderedTeam.map((member, index) => (
          <div class="team-card" style={`animation-delay: ${index * 0.1}s`}>
            {member.data.photo && (
              <div class="avatar-ring">
                <img 
                  src={member.data.photo.startsWith(import.meta.env.BASE_URL) ? member.data.photo : `${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL}/${member.data.photo.startsWith('/') ? member.data.photo.slice(1) : member.data.photo}`} 
                  alt={member.data.title} 
                  class="avatar"
                  loading="lazy"
                />
              </div>
            )}
            <h3>{member.data.title}</h3>
            <p class="role">{member.data.role}</p>
            <div class="bio">
              <member.Content />
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .page-header {
    margin-bottom: 4rem;
  }
  
  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .content-section {
    margin-bottom: 5rem;
  }

  .content-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(125, 211, 252, 0.2);
    padding-bottom: 0.5rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }

  /* FAQ Styles */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-card {
    background: linear-gradient(145deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 60%), var(--surface-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    opacity: 0;
    animation: slideUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .faq-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4), 0 0 15px rgba(125, 211, 252, 0.4);
    border-color: rgba(125, 211, 252, 0.3);
  }

  .question {
    color: var(--text-main);
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .answer {
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Team Styles */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
  }

  .team-card {
    background: linear-gradient(145deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 60%), var(--surface-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    opacity: 0;
    animation: slideUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .team-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4), 0 0 15px rgba(125, 211, 252, 0.4);
    border-color: rgba(125, 211, 252, 0.3);
  }

  .avatar-ring {
    display: inline-block;
    background: var(--accent-blue);
    border-radius: 70% 50%;
    padding: 1px;
    margin-bottom: 1rem;
    box-shadow: 0 0 15px rgba(125, 212, 252, 0.42);
  }

  .avatar {
    display: block;
    width: 120px;
    height: 120px;
    border-radius: 50% 70%;
    object-fit: cover;
    border: 0px solid var(--bg-main);
  }

  .team-card h3 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.3rem;
  }

  .role {
    color: var(--accent-orange);
    font-weight: 500;
    margin: 0.5rem 0 1rem 0;
  }

  .bio {
    color: var(--text-muted);
    font-size: 0.95rem;
    text-align: left;
    line-height: 1.6;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
