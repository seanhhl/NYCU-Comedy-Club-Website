---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const title = '歡迎';
const intro = '這是我們社團的官方網站。';
const announcementsHeading = '最新公告';

const allAnnouncements = await getCollection('announcements');
allAnnouncements.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const renderedAnnouncements = await Promise.all(allAnnouncements.map(async (ann) => {
  const { Content } = await render(ann);
  return { ...ann, Content };
}));
---
<Layout title={title}>
  <h1>{title}</h1>
  <p>{intro}</p>

  <section style="margin-top: 2rem;">
    <h2>{announcementsHeading}</h2>
    {renderedAnnouncements.length === 0 ? (
      <p><em>(目前沒有新公告)</em></p>
    ) : (
      <ul>
        {renderedAnnouncements.map(ann => (
          <li style="margin-bottom: 1rem;">
            <h3>{ann.data.title} <small style="font-weight: normal; font-size: 0.9em; color: #666;">- {ann.data.date.toLocaleDateString()}</small></h3>
            <ann.Content />
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
