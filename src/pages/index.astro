---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const title = '交大貢丸喜劇社';
const intro = '歡迎來到我們的官方網站。在這裡，我們用幽默點亮校園。';
const announcementsHeading = '最新公告';

const allAnnouncements = await getCollection('announcements');
allAnnouncements.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const renderedAnnouncements = await Promise.all(allAnnouncements.map(async (ann) => {
  const { Content } = await render(ann);
  return { ...ann, Content };
}));
---
<Layout title={title}>
  <header class="hero">
    <h1>{title}</h1>
    <p class="subtitle">{intro}</p>
  </header>

  <section class="announcements-section">
    <h2>{announcementsHeading}</h2>
    {renderedAnnouncements.length === 0 ? (
      <p class="empty-state">目前沒有新公告</p>
    ) : (
      <div class="announcements-grid">
        {renderedAnnouncements.map((ann, index) => (
          <article class="announcement-card" style={`animation-delay: ${index * 0.1}s`}>
            <div class="card-header">
              <h3>{ann.data.title}</h3>
              <span class="date">{ann.data.date.toLocaleDateString('zh-TW')}</span>
            </div>
            <div class="card-content prose">
              <ann.Content />
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .hero {
    margin-bottom: 4rem;
    text-align: center;
  }
  
  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .hero .subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
  }

  .announcements-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(125, 211, 252, 0.2);
    padding-bottom: 0.5rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }

  .announcements-grid {
    display: grid;
    gap: 2rem;
  }

  .announcement-card {
    background: linear-gradient(145deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 60%), var(--surface-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    animation: slideUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .announcement-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4), 0 0 15px rgba(125, 211, 252, 0.4);
    border-color: rgba(125, 211, 252, 0.3);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 1rem;
  }

  .card-header h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--accent-orange);
  }

  .card-header .date {
    font-size: 0.9rem;
    color: var(--text-muted);
    opacity: 0.7;
  }

  /* Style the markdown content */
  .prose {
    color: var(--text-muted);
    line-height: 1.7;
  }

  .prose :global(p) {
    margin-bottom: 1rem;
  }
  
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    margin: 1rem 0;
  }

  .prose :global(a) {
    color: var(--accent-blue);
    text-decoration: underline;
  }
  
  /* Hide Substack's native image expand buttons and link wrappers */
  .prose :global(.image-link-expand),
  .prose :global(.button-wrapper) {
    display: none !important;
  }
</style>
