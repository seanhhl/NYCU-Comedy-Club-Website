---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const title = '交大貢丸喜劇社';
const intro = '歡迎來到我們的官方網站。在這裡，我們用幽默點亮校園。';
const announcementsHeading = '最新公告';

const allAnnouncements = await getCollection('announcements');
allAnnouncements.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const renderedAnnouncements = await Promise.all(allAnnouncements.map(async (ann) => {
  const { Content } = await render(ann);
  return { ...ann, Content };
}));
---
<Layout title={title}>
  <header class="hero">
    <div class="hero-brand">
      <h1>交大貢丸<br />喜劇社</h1>
      <div class="hero-logo-container">
        <img src="/images/logo.png" alt="NYCU Comedy Club Logo" class="hero-logo" />
        
        <!-- Playful Fake Reviews (Jokes) -->
        <div class="reviews-stack">
          <div class="joke-review card-1">
            <div class="stars">★☆☆☆☆</div>
            <p>"我給六顆星，這是多出來的那顆"</p>
            <span class="author">— 算術大師</span>
          </div>
          <div class="joke-review card-2">
            <div class="stars">★★★★★</div>
            <p>"他們很好笑，真的"</p>
            <span class="author">— 媽媽</span>
          </div>
          <div class="joke-review card-3">
            <div class="stars">★★★★★</div>
            <p>"剛才有人說給五星可以領貢丸"</p>
            <span class="author">— 路人</span>
          </div>
        </div>
      </div>
    </div>
    <p class="subtitle">{intro}</p>
  </header>

  <section class="announcements-section">
    <h2>{announcementsHeading}</h2>
    {renderedAnnouncements.length === 0 ? (
      <p class="empty-state">目前沒有新公告</p>
    ) : (
      <div class="announcements-grid">
        {renderedAnnouncements.map((ann, index) => (
          <article class="announcement-card" style={`animation-delay: ${index * 0.1}s`}>
            <div class="card-header">
              <h3>{ann.data.title}</h3>
              <span class="date">{ann.data.date.toLocaleDateString('zh-TW')}</span>
            </div>
            <div class="card-content prose">
              <ann.Content />
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .hero {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-bottom: 4rem;
    text-align: center;
    padding-top: 2rem;
  }
  
  .hero-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .hero h1 {
    font-size: 6rem;
    line-height: 1.1;
    margin: 0;
    color: var(--text-main);
    text-shadow: 0 4px 30px rgba(255, 255, 255, 0.15);
    text-align: left;
  }
  
  .hero-logo-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  
  .hero-logo {
    height: 320px; /* Even larger logo */
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 40px rgba(125, 211, 252, 0.6));
    animation: float 6s ease-in-out infinite;
  }
  
  .reviews-stack {
    position: relative;
    width: 380px;
    height: 160px;
    margin-top: 1rem;
    display: flex;
    justify-content: center;
  }
  
  .joke-review {
    position: absolute;
    top: 0;
    left: 50%;
    margin-left: -140px; /* half of 280px max-width */
    width: 100%;
    background: var(--surface-card);
    border-radius: 16px;
    padding: 1rem 1.5rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.05);
    max-width: 280px;
    text-align: center;
    transition: transform 0.3s ease, z-index 0s, box-shadow 0.3s ease;
    /* initial state via css variables */
    transform: translate(var(--tx), var(--ty)) rotate(var(--r));
  }
  
  .joke-review:hover {
    z-index: 10 !important;
    animation-play-state: paused;
    box-shadow: 0 15px 40px rgba(0,0,0,0.7);
    transform: translate(var(--tx), calc(var(--ty) - 5px)) rotate(var(--r)) scale(1.05) !important;
  }
  
  .card-1 {
    --tx: -50px; --ty: 25px; --r: 12deg;
    z-index: 1;
    animation: float-card 7s ease-in-out infinite;
  }
  .card-2 {
    --tx: 0px; --ty: 0px; --r: 2deg;
    z-index: 2;
    animation: float-card 6s ease-in-out infinite 1s;
  }
  .card-3 {
    --tx: 50px; --ty: -25px; --r: -14deg;
    z-index: 3;
    animation: float-card 8s ease-in-out infinite 0.5s;
  }
  
  @keyframes float-card {
    0%, 100% { transform: translate(var(--tx), var(--ty)) rotate(var(--r)); }
    50% { transform: translate(var(--tx), calc(var(--ty) - 10px)) rotate(var(--r)); }
  }
  
  .joke-review .stars {
    color: #fbbf24;
    letter-spacing: 2px;
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
  
  .joke-review p {
    font-size: 1.1rem;
    margin: 0 0 0.5rem 0;
    font-style: italic;
    color: var(--text-main);
  }
  
  .joke-review .author {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: bold;
  }
  
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }

  .hero .subtitle {
    font-size: 1.75rem;
    color: var(--text-muted);
  }

  .announcements-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--text-main);
    border-bottom: 1px solid rgba(125, 211, 252, 0.2);
    padding-bottom: 0.5rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }

  .announcements-grid {
    display: grid;
    gap: 2rem;
  }

  .announcement-card {
    position: relative;
    z-index: 0;
    background: transparent; /* Background moved to ::before */
    border-radius: 12px;
    padding: 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    animation: slideUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  
  .announcement-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--surface-card);
    z-index: -1;
  }
  
  .announcement-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(45deg, var(--accent-orange), var(--accent-blue));
    z-index: -2;
    filter: blur(15px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }

  .announcement-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }
  
  .announcement-card:hover::after {
    opacity: 0.5;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 1rem;
  }

  .card-header h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--accent-orange);
  }

  .card-header .date {
    font-size: 0.9rem;
    color: var(--text-muted);
    opacity: 0.7;
  }

  /* Style the markdown content */
  .prose {
    color: var(--text-muted);
    line-height: 1.7;
  }

  .prose :global(p) {
    margin-bottom: 1rem;
  }
  
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    margin: 1rem 0;
  }

  .prose :global(a) {
    color: var(--accent-blue);
    text-decoration: underline;
  }
  
  /* Hide Substack's native image expand buttons and link wrappers */
  .prose :global(.image-link-expand),
  .prose :global(.button-wrapper) {
    display: none !important;
  }
  
  /* Responsive Hero */
  @media (max-width: 768px) {
    .hero-brand {
      gap: 2rem;
    }
    
    .hero h1 {
      font-size: 3.5rem;
      text-align: center;
    }
    
    .hero-logo {
      height: auto;
      width: 100%;
      max-width: 250px;
    }
    
    .reviews-stack {
      transform: scale(0.85); /* shrink the entire stack slightly to prevent horizontal overflow */
    }
  }
  
  @media (max-width: 480px) {
    .hero h1 {
      font-size: 2.5rem;
    }
    
    .hero-logo {
      max-width: 200px;
    }
    
    .reviews-stack {
      transform: scale(0.7);
    }
  }
</style>
