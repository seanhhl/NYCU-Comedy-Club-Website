---
const base = import.meta.env.BASE_URL;
---
<nav class="navbar">
  <div class="nav-content">
    <div class="brand">
      <strong>NYCU Comedy</strong>
    </div>
    <div class="nav-links">
      <a href={base}>首頁</a>
      <a href={`${base}/activities`}>活動歷程</a>
      <a href={`${base}/about`}>關於我們</a>
      <a href={`${base}/join`}>加入我們</a>
      <a href={`${base}/admin`} class="admin-login">幹部登入</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    width: 100%;
    background: rgba(9, 9, 11, 0.4); /* Make it more transparent so blur is obvious */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(125, 211, 252, 0.1); /* Subtle blue border */
    z-index: 100;
  }

  .nav-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand strong {
    font-size: 1.25rem;
    color: var(--text-main);
    letter-spacing: 1px;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-muted);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--text-main);
  }

  .admin-login {
    color: var(--accent-orange) !important;
    border: 1px solid var(--accent-orange);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    transition: all 0.3s ease !important;
  }

  .admin-login:hover {
    background: var(--glow-orange);
    box-shadow: 0 0 10px var(--glow-orange);
    color: var(--text-main) !important;
  }
</style>
